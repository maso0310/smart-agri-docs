# 智慧農業課程技術文件中心 - Systemd 服務設定
# ============================================
#
# 安裝步驟：
# 1. 複製此檔案到 /etc/systemd/system/
#    sudo cp smart-agri-docs.service /etc/systemd/system/
#
# 2. 重新載入 systemd
#    sudo systemctl daemon-reload
#
# 3. 啟用服務（開機自動啟動）
#    sudo systemctl enable smart-agri-docs
#
# 4. 啟動服務
#    sudo systemctl start smart-agri-docs
#
# 5. 查看狀態
#    sudo systemctl status smart-agri-docs

[Unit]
Description=Smart Agriculture Course Documentation Server
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/smart-agri-docs
Environment="PATH=/var/www/smart-agri-docs/venv/bin"
Environment="SECRET_KEY=your-secret-key-here"
ExecStart=/var/www/smart-agri-docs/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 wsgi:app
Restart=always
RestartSec=5

# 安全設定
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/smart-agri-docs

[Install]
WantedBy=multi-user.target
