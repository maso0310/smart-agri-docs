# 智慧農業課程技術文件中心 - 環境變數範例
# ========================================
# 複製此檔案為 .env 並填入實際值
#
# cp .env.example .env

# Flask 設定
FLASK_ENV=production
FLASK_DEBUG=false

# 安全金鑰（生產環境請使用隨機字串）
# 產生方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# 服務埠號
PORT=5000
